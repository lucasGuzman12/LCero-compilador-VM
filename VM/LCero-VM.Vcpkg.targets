<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="LCeroValidateVcpkg" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(LCeroVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')">
    <Error Text="No se encontró vcpkg. Instale el componente vcpkg de Visual Studio o defina VCPKG_ROOT." />
  </Target>
  <Import Project="$(LCeroVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets"
          Condition="Exists('$(LCeroVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />
</Project>
