LCERO_IR 1
MEM 4
CONST R3, 1
CONST R2, 2
ADD R0, R3, R2
STORE 1, R0
CONST R3, 3
CONST R2, 4
ADD R2, R3, R2
LOAD R0, 1
MUL R0, R0, R2
STORE 2, R0
CONST R3, 5
CONST R2, 6
ADD R0, R3, R2
STORE 3, R0
CONST R3, 7
CONST R2, 8
ADD R2, R3, R2
LOAD R0, 3
MUL R2, R0, R2
LOAD R0, 2
ADD R2, R0, R2
STORE 0, R2
LOAD R2, 0
PRINT R2
HALT
